# Copy this file to `.env.local` and fill in the values.
# `.env` and `.env.*` are gitignored — never commit real secrets.

# Password for protected pages/routes (see src/resources/protectedRoutes.ts)
PAGE_ACCESS_PASSWORD=password

# Secret used to sign the auth cookie. Falls back to PAGE_ACCESS_PASSWORD if unset,
# but set a dedicated random value in production — without it the password itself
# is the signing key, so anyone holding a cookie can test password guesses offline:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing either this value or PAGE_ACCESS_PASSWORD signs every visitor out.
AUTH_SECRET=

# Google Gemini API key for the FAQ chatbot (/api/chatbot).
# Leave empty to disable the chatbot — the route returns 503.
GEMINI_API_KEY=
